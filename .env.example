# Example environment variables for Contract Companion (Konect)
# MongoDB connection
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net
MONGODB_DB=contract_companion

# Root account (set strong password!)
ROOT_EMAIL=admin@example.com
ROOT_PASSWORD=changeme123

# JWT secret for signing session tokens
JWT_SECRET=replace_with_a_strong_random_value

# Cookie domain (optional) e.g. .example.com
COOKIE_DOMAIN=

# Frontend base for API calls (optional)
VITE_API_BASE=/api
